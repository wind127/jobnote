{
  "name": "jobnote",
  "version": "0.1.6",
  "description": "A local job application tracker powered by scheduled mailbox reviews.",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-public.mjs",
    "start": "node dist/cli.js serve",
    "demo": "npm run build && node scripts/demo.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
